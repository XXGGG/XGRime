{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XGRime",
  "version": "0.4.2",
  "identifier": "com.xg.xgrime",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:5174",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "XGRime",
        "width": 1020,
        "height": 690,
        "minWidth": 1020,
        "minHeight": 690,
        "decorations": false,
        "shadow": true
      },
      {
        "label": "tray-menu",
        "url": "index.html#tray",
        "title": "XGRime",
        "width": 220,
        "height": 300,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/status-icons/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
