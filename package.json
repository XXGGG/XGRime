{
  "name": "xgrime",
  "private": true,
  "version": "0.4.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-locales.ts && vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "link:bundle": "node scripts/link-bundle.mjs",
    "lint": "eslint .",
    "check:locales": "node scripts/check-locales.ts",
    "bump": "node scripts/bump.mjs",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged",
    "commit-msg": "node scripts/verify-commit-msg.mjs $1"
  },
  "lint-staged": {
    "*.{js,mjs,ts,vue}": "eslint --fix"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-fs": "^2.4.5",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-store": "^2.4.2",
    "@vueuse/core": "^14.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^0.575.0",
    "pinia": "^3.0.4",
    "reka-ui": "^2.7.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "vue": "^3.5.13",
    "vue-i18n": "^11.4.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify/json": "^2.2.432",
    "@iconify/tailwind4": "^1.2.1",
    "@tauri-apps/cli": "^2",
    "@types/node": "^25.0.10",
    "@vitejs/plugin-vue": "^5.2.1",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "lint-staged": "^17.3.0",
    "simple-git-hooks": "^2.13.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.0.3",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^2.1.10"
  }
}
